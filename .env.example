# Copy to .env for local runs (`make run`). Matches docker-compose.yml; dev-only values.
RUN_MODE=all
HTTP_ADDR=:8080
REDIS_ADDR=localhost:6379
KAFKA_BROKERS=localhost:9092
KAFKA_CONSUMER_GROUP=bidding-engine.bid-recorder
DATABASE_URL=postgres://auctions:auctions@localhost:5432/auctions?sslmode=disable
